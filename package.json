{
  "name": "tuahorroeficiente-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/prepare-pages.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm test && npm run build && npm run audit:dist",
    "audit:dist": "node scripts/audit-dist.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "@astrojs/sitemap": "^3.2.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

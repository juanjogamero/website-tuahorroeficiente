---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCalculator from '../../components/ToolCalculator.astro';
import ToolCard from '../../components/ToolCard.astro';
import Icon from '../../components/Icon.astro';
import {tools,byId,pathOf,sources} from '../../data/tools';
import {photoUrls} from '../../data/categories';
export function getStaticPaths(){return tools.filter(t=>t.group==='herramientas').map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;
const related=tool.related.map(byId).filter(Boolean);
const schema={"@context":"https://schema.org","@type":"WebApplication",name:tool.title,description:tool.description,applicationCategory:'UtilitiesApplication',operatingSystem:'Web',inLanguage:'es-ES',isAccessibleForFree:true,offers:{"@type":"Offer",price:'0',priceCurrency:'EUR'},url:new URL(pathOf(tool).replace(/^\/+/,''),new URL(import.meta.env.BASE_URL,Astro.site)).toString()};
---
<BaseLayout title={tool.title} description={tool.description} image={photoUrls[tool.image]??photoUrls.hero} schema={schema}>
<section class="tool-hero"><img class="rf-inner-bgimage" src={photoUrls[tool.image as keyof typeof photoUrls]??photoUrls.hero} alt="" aria-hidden="true"/><div class="wrap"><Breadcrumbs items={[{label:'Herramientas',url:'/herramientas/'},{label:tool.title}]}/><div class="tool-hero-grid"><div><span class="eyebrow">{tool.category.toUpperCase()} / {tool.tag.toUpperCase()}</span><h1>{tool.title}</h1><p class="lead">{tool.intro}</p><div class="hero-meta"><span><Icon name="calculator" size={17}/> Sin registro</span><span><Icon name="shield" size={17}/> Cálculo verificable</span><span><Icon name="clock" size={17}/> {tool.reading}</span></div><a href="#calculadora" class="btn btn-lime">Ir a la calculadora <Icon name="arrow" size={17}/></a></div><div class="tool-art"><span class="art-pill">UN RESULTADO HECHO PARA TI</span><img src="/illustrations/orbit.svg" alt="" width="480" height="310"/><div class="tool-art-small"><Icon name={tool.icon} size={22}/> {tool.category}</div></div></div></div></section>
<div class="wrap"><ToolCalculatortool={tool}/></div>
<section class="section explain-section"><div class="wrap"><div class="explain-layout"><div class="explain-main"><span class="eyebrow">· CÓMO INTERPRETARLO</span><h2>No basta con un número.<br/><span class="purple-text">Importa entenderlo.</span></h2><p>{tool.model}</p><div class="method-card"><span class="small-label">FÓRMULA PÚBLICA</span><p>{tool.formula}</p></div><h3>Ejemplo que puedes reproducir</h3><p>{tool.example}</p><h3>Qué no debes asumir</h3><ul class="article-bullets">{tool.limits.map(l=><li>{l}</li>)}</ul></div><aside class="explain-sidebar"><span class="eyebrow">EN 3 IDEAS</span>{tool.keyTakeaways.map((s,i)=><div class="sidebar-point"><span>{String(i+1).padStart(2,'0')}</span><p>{s}</p></div>)}<div class="sidebar-source"><Icon name="info" size={19}/><p>Última revisión metodológica: 18/11/2026. Los valores iniciales son <strong>ejemplos</strong>; no precios reales de mercado.</p></div></aside></div></div></section>
<section class="section faqs-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">· PREGUNTAS FRECUENTES</span><h2>Las dudas <span class="purple-text">importantes.</span></h2></div></div><div class="faq-list">{tool.questions.map(qa=><details><summary>{qa.q}<span aria-hidden="true">+</span></summary><p>{qa.a}</p></details>)}</div></div></section>
<section class="section source-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">· FUENTES Y RESPONSABILIDAD</span><h2>Referencias <span class="purple-text">para verificar.</span></h2><p>Las fuentes oficiales respaldan conceptos generales; no atribuyen nuestros precios de ejemplo ni las hipótesis personales.</p></div></div><div class="source-rows">{tool.src.map(id=><a href={sources[id].url} target="_blank" rel="noopener noreferrer"><span><Icon name="book" size={19}/></span><div><strong>{sources[id].name}</strong><p>{sources[id].note}</p></div><Icon name="arrowUp" size={18}/></a>)}</div><p class="source-fineprint">Responsable editorial: Tu Ahorro Eficiente. Los cálculos son orientativos; las fuentes y los supuestos deben verificarse antes de decisiones de compra o cambio de suministro. <a href="/metodologia/">Ver metodología completa</a> y <a href="/contacto/">solicitar correcciones</a>.</p></div></section>
<section class="section related-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">· SIGUE EXPLORANDO</span><h2>El siguiente <span class="purple-text">cálculo útil.</span></h2></div></div><div class="tool-grid">{related.map(t=><ToolCard tool={t}/>)}</div></div></section>
</BaseLayout>

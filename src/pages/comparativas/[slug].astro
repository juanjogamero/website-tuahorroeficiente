---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCalculator from '../../components/ToolCalculator.astro';
import ToolCard from '../../components/ToolCard.astro';
import Icon from '../../components/Icon.astro';
import {tools,byId,pathOf,sources} from '../../data/tools';
import {photoUrls} from '../../data/categories';
export function getStaticPaths(){return tools.filter(t=>t.group==='comparativas').map(tool=>({params:{slug:tool.slug},props:{tool}}));}
const {tool}=Astro.props;const related=tool.related.map(byId).filter(Boolean);
const schema={"@context":"https://schema.org","@type":"WebApplication",name:tool.title,applicationCategory:'UtilitiesApplication',operatingSystem:'Web',inLanguage:'es-ES',isAccessibleForFree:true,description:tool.description,url:new URL(pathOf(tool).replace(/^\/+/,''),new URL(import.meta.env.BASE_URL,Astro.site)).toString()};
---
<BaseLayout title={tool.title} description={tool.description} image={photoUrls.kitchen} schema={schema}>
<section class="tool-hero comparison-hero"><img class="rf-inner-bgimage" src="/images/hero-renovables.webp" alt="" aria-hidden="true"/><div class="wrap"><Breadcrumbs items={[{label:'Comparativas',url:'/comparativas/'},{label:tool.title}]}/><div class="tool-hero-grid"><div><span class="eyebrow">COMPARATIVA / COCINA</span><h1>{tool.title}</h1><p class="lead">{tool.intro}</p><div class="hero-meta"><span><Icon name="calculator" size={17}/> Datos por cocción</span><span><Icon name="shield" size={17}/> Sin promesas universales</span></div><a href="#calculadora" class="btn btn-lime">Comparar mis consumos <Icon name="arrow" size={17}/></a></div><div class="comparison-visual"><img src={photoUrls.kitchen} alt="Paneles de una instalación eléctrica renovable" width="650" height="480"/><span>Compara la misma receta y raciones</span></div></div></div></section>
<div class="wrap"><ToolCalculator tool={tool}/></div>
<section class="section explain-section"><div class="wrap"><div class="explain-layout"><article class="explain-main"><span class="eyebrow">· ANÁLISIS</span><h2>La unidad justa es la <span class="purple-text">cocción equivalente.</span></h2><p>{tool.model}</p><div class="method-card"><span class="small-label">FÓRMULA DE COMPARACIÓN</span><p>{tool.formula}</p></div><h3>Ejemplo matemático, no dato medio</h3><p>{tool.example}</p><h3>Cuándo cambia la respuesta</h3><ul class="article-bullets">{tool.limits.map(l=><li>{l}</li>)}</ul></article><aside class="explain-sidebar"><span class="eyebrow">ANTES DE DECIDIR</span>{tool.keyTakeaways.map((s,i)=><div class="sidebar-point"><span>{String(i+1).padStart(2,'0')}</span><p>{s}</p></div>)}</aside></div></div></section>
<section class="section faqs-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">· RESOLVEMOS DUDAS</span><h2>Preguntas frecuentes.</h2></div></div><div class="faq-list">{tool.questions.map(qa=><details><summary>{qa.q}<span aria-hidden="true">+</span></summary><p>{qa.a}</p></details>)}</div></div></section>
<section class="section source-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">· FUENTES</span><h2>Más información <span class="purple-text">verificable.</span></h2></div></div><div class="source-rows">{tool.src.map(id=><a href={sources[id].url} target="_blank" rel="noopener noreferrer"><span><Icon name="book" size={19}/></span><div><strong>{sources[id].name}</strong><p>{sources[id].note}</p></div><Icon name="arrowUp" size={18}/></a>)}</div><p class="source-fineprint">Modelo revisado el 18/11/2026. Los números iniciales son ficticios; no atribuidos a estos organismos. <a href="/metodologia/">Metodología</a>.</p></div></section>
<section class="section related-section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">· HERRAMIENTAS RELACIONADAS</span><h2>Amplía <span class="purple-text">la comparación.</span></h2></div></div><div class="tool-grid">{related.map(t=><ToolCard tool={t}/>)}</div></div></section>
</BaseLayout>

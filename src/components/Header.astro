---
import Icon from './Icon.astro';
---
<header class="site-header rf-header">
  <div class="rf-header-pill">
    <a class="rf-logo" href="/" aria-label="Tu Ahorro Eficiente — volver al inicio">
      <span class="rf-logo-mark" aria-hidden="true"><Icon name="zap" size={31}/></span>
      <span class="rf-logo-type"><b>Tu Ahorro</b><small>EFICIENTE</small></span>
    </a>
    <nav class="rf-nav" aria-label="Navegación principal">
      <a href="/">Inicio</a>
      <a href="/sobre-nosotros/">Nosotros</a>
      <div class="rf-menu">
        <a href="/herramientas/">Calculadoras <span aria-hidden="true">⌄</span></a>
        <div class="rf-submenu">
          <a href="/herramientas/">Todas las calculadoras</a>
          <a href="/herramientas/calculadora-consumo-electrico/">Consumo eléctrico</a>
          <a href="/herramientas/cuanto-gasta-radiador-electrico/">Radiador eléctrico</a>
          <a href="/herramientas/cuanto-gasta-aire-acondicionado/">Aire acondicionado</a>
          <a href="/herramientas/calculadora-gasto-ducha/">Coste de una ducha</a>
        </div>
      </div>
      <div class="rf-menu">
        <a href="/comparativas/">Comparativas <span aria-hidden="true">⌄</span></a>
        <div class="rf-submenu">
          <a href="/comparativas/">Todas las comparativas</a>
          <a href="/comparativas/freidora-aire-vs-horno/">Freidora de aire frente a horno</a>
          <a href="/categorias/">Explorar categorías</a>
        </div>
      </div>
      <div class="rf-menu">
        <a href="/guias/">Blog <span aria-hidden="true">⌄</span></a>
        <div class="rf-submenu">
          <a href="/guias/">Todas las guías</a>
          <a href="/guias/como-leer-factura-luz/">Entender la factura de luz</a>
          <a href="/guias/que-es-kwh/">Qué es un kWh</a>
          <a href="/fuentes/">Fuentes y metodología</a>
        </div>
      </div>
      <a href="/contacto/">Contacto</a>
    </nav>
    <a class="rf-nav-cta" href="/herramientas/">Empezar gratis</a>
    <details class="rf-mobile-menu">
      <summary aria-label="Abrir o cerrar el menú de navegación"><span>Menú</span><Icon name="menu" size={23}/></summary>
      <nav aria-label="Navegación móvil">
        <a class="rf-mobile-menu-cta" href="/herramientas/">Ir a las calculadoras <span aria-hidden="true">↗</span></a>
        <p class="rf-mobile-section">Secciones</p>
        <a href="/">Inicio</a>
        <a href="/comparativas/">Comparativas</a>
        <a href="/guias/">Blog y guías</a>
        <p class="rf-mobile-section">Calcula por temática</p>
        <a href="/categorias/electricidad/">Electricidad</a>
        <a href="/categorias/climatizacion/">Climatización</a>
        <a href="/categorias/agua/">Agua</a>
        <a href="/categorias/electrodomesticos/">Electrodomésticos</a>
        <p class="rf-mobile-section">Información</p>
        <a href="/sobre-nosotros/">Sobre el proyecto</a>
        <a href="/contacto/">Contacto</a>
      </nav>
    </details>

  </div>
</header>

<script is:inline>
  // El menú sigue funcionando sin JavaScript gracias a <details>.
  // Mejoramos el cierre al tocar fuera, seguir un enlace o pulsar Escape.
  // La cápsula permanece fija. En cuanto se desplaza la página,
  // abandona la transparencia de la fotografía y adopta fondo negro.
  const stickyHeader = document.querySelector('.rf-header');
  if (stickyHeader) {
    const syncHeader = () => stickyHeader.classList.toggle('is-scrolled', window.scrollY > 48);
    syncHeader();
    window.addEventListener('scroll', syncHeader, { passive: true });
    window.addEventListener('pageshow', syncHeader);
  }
  const mobileMenu = document.querySelector('.rf-mobile-menu');
  if (mobileMenu) {
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && mobileMenu.open) {
        mobileMenu.open = false;
        mobileMenu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('pointerdown', event => {
      if (mobileMenu.open && !mobileMenu.contains(event.target)) mobileMenu.open = false;
    });
    mobileMenu.querySelectorAll('nav a').forEach(link => {
      link.addEventListener('click', () => { mobileMenu.open = false; });
    });
  }
</script>

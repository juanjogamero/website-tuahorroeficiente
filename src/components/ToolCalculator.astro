---
import Icon from './Icon.astro';
import {calculate,parseEs,money,number} from '../lib/calculators';
import type {Tool} from '../data/tools';
interface Props{tool:Tool}
const {tool}=Astro.props;
const numbers=Object.fromEntries(tool.fields.map(f=>[f.key,parseEs(f.value)]));
const initial=calculate(tool.id,numbers);
function present(value:number,unit:string){return unit==='eur'?money(value):`${number(value)} ${unit==='litres'?'L':unit==='m3'?'m³':'kWh'}`}
---
<section class="calculator-section" aria-labelledby="calc-heading" id="calculadora">
 <div class="calc-section-heading"><div><span class="eyebrow"><span class="dot"></span> SIMULADOR GRATUITO</span><h2 id="calc-heading">Haz tus números.<br/><span class="accent">Entiende el resultado.</span></h2></div><p>Los campos vienen con <strong>valores de ejemplo, no estadísticas nacionales ni precios vigentes</strong>. Personalízalos sin crear una cuenta.</p></div>
 <div class="calculator-grid" data-calculator data-tool={tool.id}>
   <form class="calculator-form" novalidate>
    <div class="form-section-title"><span class="number-chip">01</span><div><h3>Define tu escenario</h3><p>Puedes escribir decimales con coma.</p></div></div>
    <div class="calculator-fields">
     {tool.fields.map((field,i)=><div class="field">
       <label for={`${tool.id}-${field.key}`}>{field.label}<span class="field-unit">{field.unit}</span></label>
       <input type="text" inputmode="decimal" id={`${tool.id}-${field.key}`} name={field.key} value={field.value} data-default={field.value} autocomplete="off" required aria-describedby={`${tool.id}-${field.key}-help`}/>
       <small id={`${tool.id}-${field.key}-help`}>{field.help}</small>
     </div>)}
    </div>
    <p data-error role="alert" class="form-error" tabindex="-1" hidden></p>
    <div class="calculator-actions"><button class="btn btn-lime btn-full" type="submit">Calcular mi resultado <Icon name="arrow" size={17}/></button><button class="link-reset" data-reset type="button">Restablecer valores</button></div>
    <div class="privacy-inline"><Icon name="shield" size={16}/> Sin registro. Los datos se calculan en tu navegador.</div>
   </form>
   <aside class="calculator-result" aria-label="Resumen del resultado" tabindex="-1">
     <div class="result-top"><span class="result-eyebrow">TU RESULTADO</span><span class="result-tag"><span class="dot"></span> Estimación</span></div>
     <p class="result-label" data-primary-label>{initial.primaryLabel}</p>
     <strong class="result-main" role="status" aria-live="polite" aria-atomic="true" data-primary>{money(initial.primary)}</strong>
     <p class="result-helper">Con las condiciones introducidas. No es una tarifa ni un ahorro garantizado.</p>
     <div class="result-divider"></div>
     <dl class="result-values">{initial.secondary.map((x,i)=><div><dt>{x.label}</dt><dd data-secondary={i}>{present(x.value,x.unit)}</dd></div>)}</dl>
     {initial.difference!==undefined && <div class="result-difference"><span data-difference-label>{initial.differenceLabel}</span><strong data-difference>{money(initial.difference)}</strong></div>}
     <div class="result-note"><Icon name="info" size={18}/><p data-note>{initial.note}</p></div>
     <button class="btn btn-soft btn-full" data-share type="button"><Icon name="copy" size={17}/> Copiar enlace con mis parámetros</button>
     <p class="share-note" data-share-status role="status">El enlace compartido contendrá los valores que introduzcas en la dirección URL. Evita introducir información personal.</p>
   </aside>
 </div>
</section>
<script>import '../scripts/tools-client.ts';</script>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/fidelidad.css';
import '../styles/header-hero-proporciones.css';
import '../styles/mobile-ux.css';
import '../styles/cabecera-referencias.css';
import '../styles/presentacion-editorial.css';
import '../styles/resumen-soluciones.css';
import '../styles/soluciones-oscuras.css';
import '../styles/beneficios-portada.css';
import '../styles/casos-fotograficos.css';
import '../styles/primeros-pasos.css';
import '../styles/preguntas-frecuentes-portada.css';
import '../styles/banner-pie-final.css';
import '../styles/pagina-nosotros.css';
import '../styles/catalogo-calculadoras.css';
interface Props{title:string;description:string;image?:string;ogType?:string;canonical?:string;schema?:Record<string,unknown>|Array<Record<string,unknown>>;noindex?:boolean}
const {title,description,image,ogType='website',canonical,schema,noindex=false}=Astro.props;
const isPreview=process.env.PUBLICATION_MODE !== 'production';
const basePath=import.meta.env.BASE_URL;
const demoBase=new URL(basePath, Astro.site??'https://tuahorroeficiente.es').toString();
const originalPath=Astro.url.pathname;
const localPath=(basePath!=='/' && originalPath.startsWith(basePath))
  ? originalPath.slice(basePath.length)
  : originalPath.replace(/^\/+/, '');
const isHomePage = localPath === '' || localPath === 'index.html';
const isAboutPage = ['sobre-nosotros', 'sobre-nosotros/', 'sobre-nosotros/index.html'].includes(localPath);
const isToolsPage = ['herramientas', 'herramientas/', 'herramientas/index.html'].includes(localPath);
const isCalculatorPage = /^herramientas\/[^/]+\/?$/.test(localPath) || /^comparativas\/[^/]+\/?$/.test(localPath);
const url=canonical??new URL(localPath, demoBase).toString();
const siteTitle=title.includes('Tu Ahorro Eficiente')?title:`${title} | Tu Ahorro Eficiente`;
const ogImage=image?new URL(image.replace(/^\/+/,''),demoBase).toString():undefined;
const defaultSchema={"@context":"https://schema.org","@type":"WebSite",name:'Tu Ahorro Eficiente',url:demoBase,inLanguage:'es-ES',description:'Calculadoras gratuitas de consumo y ahorro doméstico para España.'};
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{siteTitle}</title><meta name="description" content={description}/>
<link rel="canonical" href={url}/>
{(noindex || isPreview) && <meta name="robots" content="noindex,follow"/>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<meta name="theme-color" content="#234b68"/>
<meta property="og:type" content={ogType}/><meta property="og:locale" content="es_ES"/>
<meta property="og:site_name" content="Tu Ahorro Eficiente"/>
<meta property="og:title" content={siteTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/>
{ogImage && <meta property="og:image" content={ogImage}/>}
<meta name="twitter:card" content={ogImage?'summary_large_image':'summary'}/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
{!schema && (Astro.url.pathname==='/' || Astro.url.pathname===import.meta.env.BASE_URL) && <script type="application/ld+json" set:html={JSON.stringify(defaultSchema)} />}
</head>
<body class={isHomePage ? 'page-home' : isAboutPage ? 'page-about' : isToolsPage ? 'page-tools' : isCalculatorPage ? 'page-calculator' : undefined}>
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<Header/>
<main id="contenido"><slot/></main>
<Footer/>
<script is:inline>
// Respaldo visual para imágenes locales que fallaran.
(function(){for(const img of document.querySelectorAll('img')){
 const hide=()=>img.classList.add('solar-photo-unavailable');
 img.addEventListener('error',hide,{once:true});
 if(img.complete && img.naturalWidth===0)hide();
}})();
</script>
</body></html>
